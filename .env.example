# Local mode runs without secrets. Copy this file to .env to configure integrations.
PORT=4173
HOST=127.0.0.1
# Set an HTTPS origin and a random >=32-character OPERATOR_TOKEN before external hosting.
PUBLIC_ORIGIN=
OPERATOR_TOKEN=
INGEST_TOKEN=
WORKFLOW_DB_PATH=data/runtime/workflow.sqlite
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=
# Verify the version supported by your Meta app. Official docs checked 20 Nov 2026 show v27.0.
META_GRAPH_VERSION=v27.0
# Never enabled automatically. Each comment still requires approval and an explicit Publish click.
META_PAGE_PUBLISH_ENABLED=false
# Chrome comment sender is opt-in. Each reply requires review and final confirmation.
BROWSER_REPLY_ENABLED=false
# PetMommy style: template by default; Ollama runs only on this machine.
REPLY_LLM_ENABLED=false
REPLY_LLM_PROVIDER=ollama
# For OpenAI set provider=openai, model=gpt-4.1-mini and a server-only key.
# Every OpenAI rewrite requires reviewing its input in the Dashboard.
REPLY_LLM_MODEL=qwen2.5:7b-instruct
REPLY_OLLAMA_URL=http://127.0.0.1:11434
OPENAI_API_KEY=
# HTTPS origin of THIS Node server, after hosting it publicly. Empty uses UTM only.
# The existing static public website cannot run the click counter.
GUIDE_TRACKING_ORIGIN=
MEONGSILJANG_URL=https://meongsiljang.com/th
# Only set a destination confirmed by your Televet provider; no booking/API is implied.
TELEVET_URL=

# Optional local browser worker. Uses a separate Chrome profile, no Meta API key.
COLLECTOR_GROUP_URL=https://web.facebook.com/groups/1067156573375730
COLLECTOR_APP_PORT=4187
COLLECTOR_BROWSER_CHANNEL=chrome
COLLECTOR_REFRESH_SECONDS=60
COLLECTOR_MAX_SCROLLS=3
COLLECTOR_MAX_POSTS=40
# Set only after inspecting a changed page layout. Empty uses built-in selectors.
COLLECTOR_MESSAGE_SELECTOR=

# One-shot Batch mode: automatically read another chunk when 40 is reached.
COLLECTOR_BATCH_KNOWN_STREAK=5
COLLECTOR_BATCH_MAX_ROUNDS=25
COLLECTOR_BATCH_MAX_SCROLLS=300
COLLECTOR_BATCH_MAX_SECONDS=900
COLLECTOR_BATCH_STALL_LIMIT=5
COLLECTOR_BATCH_LOGIN_WAIT_SECONDS=60
COLLECTOR_BATCH_ANALYSIS_WAIT_SECONDS=120
