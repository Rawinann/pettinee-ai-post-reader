# Copy to .env.cloud locally. Set the same server settings in Vercel separately.
# Never use NEXT_PUBLIC_ or VITE_ prefixes for these values.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLER-HOST/DB?sslmode=verify-full
PUBLIC_ORIGIN=https://YOUR-PROJECT.vercel.app
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
DASHBOARD_USERS_JSON=[]
COLLECTOR_GROUP_ID=1067156573375730
# Pilot defaults to manual replies. Do not enable until deliberately testing browser publishing.
CLOUD_BROWSER_PUBLISH_ENABLED=false
