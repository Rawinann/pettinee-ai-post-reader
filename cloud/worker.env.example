# Copy to .env.worker on the owner's computer only; use its unique provisioned token.
CLOUD_ORIGIN=https://YOUR-PROJECT.vercel.app
CLOUD_WORKER_ID=developer
CLOUD_FACEBOOK_ACCOUNT="ชื่อบัญชีที่ Chrome แสดงจริง"
CLOUD_WORKER_TOKEN=REPLACE_WITH_THIS_WORKERS_RANDOM_TOKEN
CLOUD_WORKER_PUBLISH_ENABLED=true
CLOUD_WORKER_POLL_SECONDS=5
REPLY_LLM_ENABLED=true
REPLY_LLM_PROVIDER=ollama
REPLY_LLM_MODEL=qwen2.5:7b-instruct
# Set a different profile for each worker; leave blank to derive it from worker ID.
# COLLECTOR_PROFILE_DIR=data/runtime/cloud-developer-profile
# OpenAI is optional: admin-reviewed rewrite only. Do not copy its key to Vercel/browser.
# REPLY_LLM_PROVIDER=openai
# REPLY_LLM_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=
